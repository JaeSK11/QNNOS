# Virtual environments
QNNenv/
venv/
.venv/

# Datasets — nPrint CSVs are large (up to 13 GB) and contain raw source IPs.
# See README "Dataset" section for how to generate your own.
data/*.csv
!data/labels.csv

# Training run artifacts (published checkpoints models/*.pt + *.json are kept)
models/training_progress*.json
models/training_log.txt
models/*.resume.pt
models/*.tmp

# Generated evaluation/inspection outputs
models/*_inspection.json
models/*_inspection.txt
models/*_heldout.txt
models/*_heldout_preds.npz

# Local scratch analyses and archived runs (kept on disk, not published)
models/_*
models/archive_*/

# Slide decks and other presentation files
*.pptx

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Local tool settings
.claude/settings.local.json

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Local AI-assistant project notes (not part of the published repo)
CLAUDE.md
